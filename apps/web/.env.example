# Database & Supabase configuration
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
DIRECT_URL="postgresql://user:password@localhost:5432/dbname"
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# LLM provider keys
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""

# Chain configuration
MONAD_TESTNET_RPC_URL="https://testnet-rpc.monad.xyz"
MONAD_REGISTRY_ADDRESS=""

# App URL & Cookie Security
# NEXT_PUBLIC_APP_URL: Canonical base URL of the app (e.g. "https://argus.io" or "http://localhost:3000")
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# COOKIE_SECURE: Explicitly override cookie Secure flag. Set to "false" for local HTTP testing, "true" for HTTPS production.
# If omitted, defaults to secure (true) in production unless running in development or localhost.
COOKIE_SECURE="false"
