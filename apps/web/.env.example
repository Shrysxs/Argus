# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
# DATABASE_URL may point at a pooler (e.g. Supabase :6543 with ?pgbouncer=true);
# DIRECT_URL must be a direct connection (used by `prisma migrate`).
DATABASE_URL="postgresql://user:password@localhost:5432/argus"
DIRECT_URL="postgresql://user:password@localhost:5432/argus"

# ─── LLM providers (at least one) ───────────────────────────────────────────
# All configured providers are used as an ordered failover: Groq → OpenRouter → Gemini → OpenAI.
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
# Optional overrides
# GROQ_MODEL="openai/gpt-oss-20b"
# OPENROUTER_MODEL="openai/gpt-oss-20b"
# GEMINI_MODEL="gemini-2.5-flash"
# OPENAI_MODEL="gpt-4.1-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"   # any OpenAI-compatible server

# ─── Market data (optional, strongly recommended in production) ─────────────
# The keyless CoinGecko API is heavily rate limited from shared cloud IPs.
COINGECKO_API_KEY=""          # free "Demo" key
# COINGECKO_PRO_API_KEY=""    # paid plan (uses pro-api.coingecko.com)
CRYPTOCOMPARE_API_KEY=""      # fallback provider

# ─── Chain (Monad testnet) ───────────────────────────────────────────────────
MONAD_TESTNET_RPC_URL="https://testnet-rpc.monad.xyz"
MONAD_REGISTRY_ADDRESS="0x1001b9A1c69E513F7D463e3578bDeE7B94295919"
NEXT_PUBLIC_MONAD_REGISTRY_ADDRESS="0x1001b9A1c69E513F7D463e3578bDeE7B94295919"
# Public RPC used by the in-browser verifier (must not contain secrets)
NEXT_PUBLIC_MONAD_RPC_URL="https://testnet-rpc.monad.xyz"
# Relayer key for "Argus relayer" seals (0x-prefixed). Testnet only —
# move to a KMS/relayer service before mainnet (AGENTS.md §9).
MONAD_SIGNER_PRIVATE_KEY=""

# ─── Billing & scoring ──────────────────────────────────────────────────────
ANALYSIS_COST_CENTS="100"     # 0 = free runs
OUTCOME_HORIZON_DAYS="7"
# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""

# ─── Rate limiting (recommended in production) ──────────────────────────────
# Without these, limits are per-instance (in-memory) only.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Force the session cookie Secure flag ("true" in HTTPS production, "false" for local HTTP).
COOKIE_SECURE="false"
