// Prisma schema for Argus authentication & database
// Postgres provider for user management & session tracking

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String          @map("password_hash")
  createdAt      DateTime        @default(now()) @map("created_at")
  sessions       Session[]
  analyzeResults AnalyzeResult[]

  // TODO: Link connected wallet address to user account (ONCHAIN.md §1)

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

model AnalyzeResult {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset             String
  recommendation    String
  confidence        Float
  breakdown         Json
  disagreement      Boolean  @default(false)
  dataSnapshotHash  String   @map("data_snapshot_hash")
  promptVersionHash String   @map("prompt_version_hash")
  sealed            Boolean  @default(false)
  txHash            String?  @map("tx_hash")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("analyze_results")
}
