{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "build": "prisma generate --schema=prisma/schema.prisma && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "vercel-build": "sh scripts/vercel-build.sh"
  },
  "dependencies": {
    "@argus/agents": "*",
    "@argus/chain-adapters": "*",
    "@argus/consensus": "*",
    "@argus/data-layer": "*",
    "@argus/shared-types": "*",
    "@prisma/client": "^6.4.1",
    "@workspace/ui": "*",
    "argon2": "^0.45.2",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "eslint": "^9",
    "prisma": "^6.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
